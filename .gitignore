result
# No committed lock — first `nix develop` generates it per-project (see
# docs/plan/issues/2_align_template_with_fleet_conventions.md). Ignoring it
# also stops Nix auto-staging the generated lock, which breaks
# `git pull` autostash. To pin one anyway: git add -f flake.lock
flake.lock
